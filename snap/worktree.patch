+    class Recorder:
+        def __init__(self) -> None:
+            self.posts: list[dict[str, object]] = []
+
+        async def chat_postMessage(self, **kwargs: object) -> dict[str, object]:
+            self.posts.append(kwargs)
+            return {"ok": True, "ts": "1"}
